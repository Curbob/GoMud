# Discord Bot Configuration for MudBot

# Discord bot token (required)
# Get from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord Guild ID (optional, for faster command registration)
# Get by right-clicking your server in Discord with Developer Mode enabled
DISCORD_GUILD_ID=your_guild_id_here

# GoMud users directory (optional, auto-detected if not specified)
# GOMUD_USERS_PATH=/path/to/GoMud/_datafiles/world/default/users

# Security settings
# API rate limiting (requests per minute per user)
RATE_LIMIT=5

# Restrict MudBot to a single Discord channel ID for responses and scheduled sayings
DISCORD_CHANNEL_ID=1479210431489769652

# Scheduled random sayings (0 disables)
MUDBOT_SAY_INTERVAL_MINUTES=0
MUDBOT_QUIET_START_HOUR=2
MUDBOT_QUIET_END_HOUR=9
